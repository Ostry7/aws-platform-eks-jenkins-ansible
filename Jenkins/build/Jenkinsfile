pipeline {
    agent { label 'build-agent' }

    environment {
        ECR_REPO = 'test'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Git repo') {
            steps {
                checkout scmGit(
                    branches: [[name: '*']],
                    extensions: [],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Ostry7/aws-platform-eks-jenkins-ansible'
                    ]]
                )
            }
        }

        stage('Start Docker daemon') {
            steps {
                sh 'dockerd &'
                sh 'sleep 15'
                sh 'docker info'
            }
        }

        stage('Build docker image'){
            dir('app'){
                steps{
                    sh "docker build -t ${ECR_REPO}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Login to ECR') {
            steps {
                dir('terraform-infra'){
                    sh '''
                    terraform init
                    export ecr_region=$(terraform output -raw ecr_region)
                    export ecr_account_id=$(terraform output -raw ecr_account_id)
                    aws ecr get-login-password --region $ecr_region | \
                    docker login --username AWS --password-stdin $ecr_account_id.dkr.ecr.$ecr_region.amazonaws.com
                '''
                }

            }
        }
    }
}