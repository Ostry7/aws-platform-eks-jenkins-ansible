pipeline {
    agent { label 'build-agent' }

    environment {
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Sleep only during indexing') {
            when {
                triggeredBy 'BranchIndexingCause'
            }
            steps {
                echo "It's indexing phase so I need to wait for ECR and EKS deployment first"
                sh 'sleep 600'
            }
        }

        stage('Checkout Git repo') {
            steps {
                checkout scmGit(
                    branches: [[name: '*']],
                    extensions: [],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Ostry7/aws-platform-eks-jenkins-ansible'
                    ]]
                )
            }
        }

        stage('Start Docker daemon') {
            steps {
                sh 'dockerd &'
                sh 'sleep 15'
                sh 'docker info'
            }
        }

        stage('Build docker image'){
            steps {
                dir('terraform-infra'){
                    script{
                        sh 'terraform init'
                        env.ECR_REPO = sh(script: 'terraform output -raw ecr_name', returnStdout: true).trim()
                        
                    }
                }
                dir('app'){
                    sh "docker build -t ${ECR_REPO}:1.${IMAGE_TAG} ."
                }

            }
        }

        stage('Login to ECR') {
            steps {
                dir('terraform-infra'){
                    sh 'terraform init'
                    script {
                        env.ECR_REGION = sh(script: 'terraform output -raw ecr_region', returnStdout: true).trim()
                        env.ECR_ACCOUNT_ID = sh(script: 'terraform output -raw ecr_account_id', returnStdout: true).trim()
                    }
                    sh '''
                    aws ecr get-login-password --region $ECR_REGION | \
                    docker login --username AWS --password-stdin $ECR_ACCOUNT_ID.dkr.ecr.$ECR_REGION.amazonaws.com
                '''
                }
            }
        }

        stage('Push docker image to ECR'){
            steps{
                dir('app') {
                    sh "docker tag ${env.ECR_REPO}:1.${IMAGE_TAG} ${env.ECR_ACCOUNT_ID}.dkr.ecr.${env.ECR_REGION}.amazonaws.com/${env.ECR_REPO}:1.${IMAGE_TAG}"
                    sh "docker push ${env.ECR_ACCOUNT_ID}.dkr.ecr.${env.ECR_REGION}.amazonaws.com/${env.ECR_REPO}:1.${IMAGE_TAG}"
                    echo 'Successfully pushed image'
                }
            }
        }

        stage('Create DB secret') {
            steps {
                dir('terraform-infra') {
                    script {
                        env.EKS_CLUSTER_NAME= sh(script: 'terraform output -raw eks_cluster_name', returnStdout: true).trim()
                        env.DB_HOST     = sh(script: 'terraform output -raw db_host', returnStdout: true).trim()
                        env.DB_PASSWORD = sh(script: 'terraform output -raw db_password', returnStdout: true).trim()
            }
        }

        sh 'aws eks update-kubeconfig --region $ECR_REGION --name $EKS_CLUSTER_NAME'

        sh '''
            kubectl create secret generic db-credentials \
              --from-literal=DB_HOST=$DB_HOST \
              --from-literal=DB_PORT=5432 \
              --from-literal=DB_NAME=devops_db \
              --from-literal=DB_USER=postgres \
              --from-literal=DB_PASSWORD=$DB_PASSWORD \
              --dry-run=client -o yaml | kubectl apply -f -
        '''
    }
}

        stage('Prod deploy EKS'){
            steps {
                dir('terraform-infra'){
                    script{
                        env.IMAGE = "${env.ECR_ACCOUNT_ID}.dkr.ecr.${env.ECR_REGION}.amazonaws.com/${env.ECR_REPO}:1.${env.IMAGE_TAG}"
                    }
                }

                sh '''
                    export IMAGE
                    envsubst < k8s/deployment.yaml | kubectl apply -f -
                    kubectl apply -f k8s/service.yaml
                    kubectl rollout status deployment/prod-app --timeout=120s
                '''
            }
        }
        stage('Init DB schema'){
            steps{
                sh '''
                    kubectl run psql-init --restart=Never --image=postgres:16 \
                      --env="PGPASSWORD=$DB_PASSWORD" \
                      --command -- sleep 300
        
                    kubectl wait --for=condition=Ready pod/psql-init --timeout=60s
        
                    kubectl cp app/init-db.sql psql-init:/tmp/init.sql
                    kubectl exec psql-init -- psql -h $DB_HOST -U postgres -d devops_db -f /tmp/init.sql
        
                    kubectl delete pod psql-init
                '''
            }
        }
    }
}
