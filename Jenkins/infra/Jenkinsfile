pipeline {
    agent { label 'infra-agent' }

    stages {
        stage('Checkout Git repo') {
            steps {
                checkout scmGit(
                    branches: [[name: '*']],
                    extensions: [],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Ostry7/aws-platform-eks-jenkins-ansible'
                    ]]
)
            }
        }

        stage('Terraform init') {
            steps {
                dir('terraform-infra'){
                    sh 'terraform fmt'
                    sh 'terraform init'
                }
            }
        }
        stage('Terraform apply') {
            steps {
                dir('terraform-infra'){
                    sh 'terraform apply --auto-approve'
                    script {
                        env.ECR_REGION = sh(script: 'terraform output -raw ecr_region', returnStdout: true).trim()
                        env.EKS_CLUSTER_NAME = sh(script: 'terraform output -raw eks_cluster_name', returnStdout: true).trim()
                    }
                    sh 'aws eks update-kubeconfig --region $ECR_REGION --name $EKS_CLUSTER_NAME'
                }
            }
        }
        stage('Configure kubectl') {
            steps {
                sh 'aws sts get-caller-identity'
                sh '''
                    mkdir -p ~/.kube
                    aws eks update-kubeconfig --region ${ECR_REGION} --name ${EKS_CLUSTER_NAME}
                    kubectl cluster-info
                    kubectl get nodes
                '''
            }
        }
        stage('Install Helm'){
            steps{
                sh '''
                    HELM_BUILDKITE_APT_KEY_ID="DDF78C3E6EBB2D2CC223C95C62BA89D07698DBC6"
                    
                    sudo apt-get install curl gpg apt-transport-https --yes
                    
                    curl -fsSL https://packages.buildkite.com/helm-linux/helm-debian/gpgkey > "${TMPDIR:-/tmp}/helm.gpg"
                    
                    # Ensure that the key ID matches to prevent a repository compromise from establishing an attacker controlled key
                    if [ "$(gpg --show-keys --with-colons "${TMPDIR:-/tmp}/helm.gpg" | awk -F: '$1 == "fpr" {print $10}' | head -n 1)" != "${HELM_BUILDKITE_APT_KEY_ID}" ]; then echo "ERROR:                   Unexpected Helm APT key ID: potential key compromise"; exit 1; fi
                    
                    cat "${TMPDIR:-/tmp}/helm.gpg" | gpg --dearmor | sudo tee /usr/share/keyrings/helm.gpg > /dev/null
                    echo "deb [signed-by=/usr/share/keyrings/helm.gpg] https://packages.buildkite.com/helm-linux/helm-debian/any/ any main" | sudo tee /etc/apt/sources.list.d/helm-stable-debian.list
                    
                    sudo apt-get update
                    sudo apt-get install helm -y
                '''
            }
        }
        stage('Install Hashicorp Vault'){
            steps{
                sh '''
                    if helm status vault -n vault > /dev/null 2>&1; then
                        echo "Vault already installed, upgrading config"
                        kubectl delete mutatingwebhookconfiguration vault-agent-injector-cfg --ignore-not-found
                        helm upgrade vault hashicorp/vault --namespace vault \
                            --set "server.dev.enabled=true" \
                            --set "injector.enabled=true"
                    else
                        helm install vault hashicorp/vault --namespace vault --create-namespace \
                            --set "server.dev.enabled=true" \
                            --set "injector.enabled=true"
                    fi
                '''
            }
        }
        stage('Install Vault CLI'){
            steps{
                sh '''
                    wget -O- https://apt.releases.hashicorp.com/gpg | sudo gpg --batch --yes --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
                    echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list
                    sudo apt update && sudo apt install vault -y
                '''
    }
}
        stage('Configure Vault Kubernetes Auth'){
    steps{
        sh '''
            kubectl port-forward -n vault svc/vault 8200:8200 &
            PF_PID=$!
            sleep 5

            export VAULT_ADDR="http://127.0.0.1:8200"
            export VAULT_TOKEN="root"

            if ! vault auth list | grep -q "kubernetes/"; then
                vault auth enable kubernetes
            fi

            vault write auth/kubernetes/config \
                kubernetes_host="https://kubernetes.default.svc:443"

            echo 'path "postgres/creds/app-role" {' > /tmp/app-policy.hcl
            echo '  capabilities = ["read"]' >> /tmp/app-policy.hcl
            echo '}' >> /tmp/app-policy.hcl
            vault policy write app-policy /tmp/app-policy.hcl

            vault write auth/kubernetes/role/app-role \
                bound_service_account_names=myapp-sa \
                bound_service_account_namespaces=prod \
                policies=app-policy \
                ttl=1h

            kill $PF_PID
        '''
    }
}
        stage('Set database password rotation'){
            steps{
                dir('terraform-infra'){
                    sh 'terraform apply --auto-approve'
                    script {
                        env.DB_NAME = sh(script: 'terraform output -raw db_name', returnStdout: true).trim()
                        env.DB_HOST = sh(script: 'terraform output -raw db_host', returnStdout: true).trim()
                        env.DB_ADMIN_PASSWORD = sh(script: 'terraform output -raw db_password', returnStdout: true).trim()
                    }
                    sh '''
                        # port forward to pod
                        kubectl port-forward -n vault svc/vault 8200:8200 & PF_PID=$!
                        sleep 10

                        export VAULT_ADDR="http://127.0.0.1:8200"
                        export VAULT_TOKEN="root"

                        vault secrets enable -path=postgres database
                        vault write postgres/config/connection \
                            plugin_name=postgresql-database-plugin \
                            connection_url="postgresql://{{username}}:{{password}}@$DB_HOST:5432/$DB_NAME?sslmode=disable" \
                            allowed_roles="app-role" \
                            username="postgres" \
                            password="$DB_ADMIN_PASSWORD"

                        vault write postgres/roles/app-role \
                            db_name=postgres \
                            creation_statements="CREATE ROLE \"{{name}}\" WITH LOGIN PASSWORD '{{password}}' VALID UNTIL '{{expiration}}'; GRANT ALL PRIVILEGES ON DATABASE $DB_NAME TO \"{{name}}\";"

                        kill $PF_PID
                    '''
                }
            }   
        }
    }
}
